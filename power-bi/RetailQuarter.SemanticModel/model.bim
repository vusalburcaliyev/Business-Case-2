        "measures": [
          {
            "name": "Late deliveries",
            "expression": "IF(HASONEVALUE('Quarter'[Quarter]), SUM('States'[Late]))",
            "formatString": "#,0"
          },
          {
            "name": "State late rate",
            "expression": "IF(HASONEVALUE('Quarter'[Quarter]), DIVIDE([Late deliveries], SUM('States'[Measured])))",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
