      {
        "name": "Quarter KPIs",
        "columns": [
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter",
            "summarizeBy": "none"
          },
          {
            "name": "Placed",
            "dataType": "int64",
            "sourceColumn": "Placed",
            "summarizeBy": "none"
          },
          {
            "name": "Delivered",
            "dataType": "int64",
            "sourceColumn": "Delivered",
            "summarizeBy": "none"
          },
          {
            "name": "Sales cents",
            "dataType": "int64",
            "sourceColumn": "Sales cents",
            "summarizeBy": "none"
          },
          {
            "name": "Items",
            "dataType": "int64",
            "sourceColumn": "Items",
            "summarizeBy": "none"
          },
          {
            "name": "Canceled",
            "dataType": "int64",
            "sourceColumn": "Canceled",
            "summarizeBy": "none"
          },
          {
            "name": "Measured",
            "dataType": "int64",
            "sourceColumn": "Measured",
            "summarizeBy": "none"
          },
          {
            "name": "On time",
            "dataType": "int64",
            "sourceColumn": "On time",
            "summarizeBy": "none"
          },
          {
            "name": "Buyers",
            "dataType": "int64",
            "sourceColumn": "Buyers",
            "summarizeBy": "none"
          },
          {
            "name": "Repeat buyers",
            "dataType": "int64",
            "sourceColumn": "Repeat buyers",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Merchandise sales",
            "expression": "DIVIDE(SUM('Quarter KPIs'[Sales cents]), 100)",
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00)"
          },
          {
            "name": "Delivered orders",
            "expression": "SUM('Quarter KPIs'[Delivered])",
            "formatString": "#,0"
          },
          {
            "name": "Average order value",
            "expression": "DIVIDE([Merchandise sales], [Delivered orders])",
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00)"
          },
          {
            "name": "Items per order",
            "expression": "DIVIDE(SUM('Quarter KPIs'[Items]), [Delivered orders])",
            "formatString": "0.00"
          },
          {
            "name": "Cancellation rate",
            "expression": "DIVIDE(SUM('Quarter KPIs'[Canceled]), SUM('Quarter KPIs'[Placed]))",
            "formatString": "0.00%"
          },
          {
            "name": "On-time delivery rate",
            "expression": "DIVIDE(SUM('Quarter KPIs'[On time]), SUM('Quarter KPIs'[Measured]))",
            "formatString": "0.00%"
          },
          {
            "name": "Repeat buyer rate",
            "expression": "IF(HASONEVALUE('Quarter'[Quarter]), DIVIDE(SUM('Quarter KPIs'[Repeat buyers]), SUM('Quarter KPIs'[Buyers])))",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "Quarter KPIs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Snapshot = Json.Document(Binary.Decompress(Binary.FromText(\"RY3LDcRACEN7ydkrYcPwKSPnKP23sZNopb08ATb2dR0y1ufUgfEY9HSAWhynG2iWQvpz30gnusbB1o33tz8nD4iyhra5oLIIb9+7rxLo/lNYU7ZnkQizf8Ju50zNZkZCbcWVGZAyCqte4altbY4PoVj3/QU=\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Snapshot, type table [#\"Quarter\" = nullable text, #\"Placed\" = nullable number, #\"Delivered\" = nullable number, #\"Sales cents\" = nullable number, #\"Items\" = nullable number, #\"Canceled\" = nullable number, #\"Measured\" = nullable number, #\"On time\" = nullable number, #\"Buyers\" = nullable number, #\"Repeat buyers\" = nullable number]),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"Placed\", Int64.Type}, {\"Delivered\", Int64.Type}, {\"Sales cents\", Int64.Type}, {\"Items\", Int64.Type}, {\"Canceled\", Int64.Type}, {\"Measured\", Int64.Type}, {\"On time\", Int64.Type}, {\"Buyers\", Int64.Type}, {\"Repeat buyers\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
